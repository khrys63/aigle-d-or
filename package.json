{
  "name": "aigle-dor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remake web de L'Aigle d'Or (Loriciels, 1984)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:editor": "vite --config vite.editor.config.ts",
    "build": "tsc --noEmit && vite build",
    "build:editor": "tsc --noEmit && vite build --config vite.editor.config.ts",
    "build:all": "npm run build && npm run build:editor",
    "preview": "vite preview"
  },
  "devDependencies": {
    "terser": "^5.49.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
